{
  "name": "@audio/eq-graphic",
  "version": "1.2.3",
  "description": "Graphic equalizer using ISO octave-band center frequencies",
  "type": "module",
  "sideEffects": false,
  "main": "graphic-eq.js",
  "types": "./graphic-eq.d.ts",
  "exports": {
    ".": {
      "types": "./graphic-eq.d.ts",
      "default": "./graphic-eq.js"
    },
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "graphic-eq.js",
    "graphic-eq.d.ts",
    "audio.js",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/biquad": "^1.1.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "eq",
    "equalizer",
    "graphic"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "audio": "./audio.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/eq.git",
    "directory": "packages/eq-graphic"
  },
  "funding": "https://github.com/sponsors/audiojs"
}
