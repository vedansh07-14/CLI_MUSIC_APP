{
  "name": "@audio/eq-tilt",
  "version": "1.2.3",
  "description": "Tilt EQ — see-saw around a pivot frequency",
  "type": "module",
  "sideEffects": false,
  "main": "tilt.js",
  "types": "./tilt.d.ts",
  "exports": {
    ".": {
      "types": "./tilt.d.ts",
      "default": "./tilt.js"
    },
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "tilt.js",
    "tilt.d.ts",
    "audio.js",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/biquad": "^1.1.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "eq",
    "equalizer",
    "tilt"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "audio": "./audio.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/eq.git",
    "directory": "packages/eq-tilt"
  },
  "funding": "https://github.com/sponsors/audiojs"
}
