{
  "name": "@audio/eq-dynamic",
  "version": "1.2.3",
  "description": "Dynamic EQ — per-band peaking gain driven by band energy (Pro-Q3/soothe class, generalized de-esser)",
  "type": "module",
  "sideEffects": false,
  "main": "dynamic.js",
  "types": "./dynamic.d.ts",
  "exports": {
    ".": {
      "types": "./dynamic.d.ts",
      "default": "./dynamic.js"
    },
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dynamic.js",
    "dynamic.d.ts",
    "audio.js",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/biquad": "^1.1.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "eq",
    "dynamic-eq",
    "soothe"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "audio": "./audio.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/eq.git",
    "directory": "packages/eq-dynamic"
  },
  "funding": "https://github.com/sponsors/audiojs"
}
