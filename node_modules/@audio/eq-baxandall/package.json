{
  "name": "@audio/eq-baxandall",
  "version": "1.2.3",
  "description": "Baxandall tone control — bass/treble shelving with reciprocal characteristics",
  "type": "module",
  "sideEffects": false,
  "main": "baxandall.js",
  "types": "./baxandall.d.ts",
  "exports": {
    ".": {
      "types": "./baxandall.d.ts",
      "default": "./baxandall.js"
    },
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "baxandall.js",
    "baxandall.d.ts",
    "audio.js",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/biquad": "^1.1.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "eq",
    "equalizer",
    "baxandall"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "audio": "./audio.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/eq.git",
    "directory": "packages/eq-baxandall"
  },
  "funding": "https://github.com/sponsors/audiojs"
}
